---
// 「合格実績」ページ。
// 表示内容はすべて src/data/achievements.ts から取得しています。
// 合格実績を追加・変更したい場合は data ファイルのみ編集してください。
// カード形式ではなく、カテゴリ（中学・高校・大学）ごとに列挙するだけのシンプルな一覧です。
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import StickyCta from "../components/StickyCta.astro";
import CtaButton from "../components/CtaButton.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { site } from "../config/site";
import { achievements, achievementCategoryOrder } from "../data/achievements";

const title = `合格実績｜${site.name}`;
const description =
  "個人契約の家庭教師として指導した生徒の合格実績です。集団塾・個別指導塾での実績ではなく、指導した生徒本人の合格校のみを掲載しています。";

const groupedAchievements = achievementCategoryOrder
  .map((category) => ({
    category,
    schools: achievements.filter((achievement) => achievement.category === category),
  }))
  .filter((group) => group.schools.length > 0);
---

<BaseLayout title={title} description={description}>
  <Header />
  <main id="main">
    <section class="section" aria-labelledby="results-heading">
      <div class="container">
        <p class="breadcrumb"><a href="/">トップページ</a><span aria-hidden="true">›</span>合格実績</p>

        <SectionHeading eyebrow="指導実績" title="合格実績" id="results-heading" />

        <p class="results-note">
          ※ 個別指導塾・家庭教師として担当した生徒の合格校のみを記載しています。
        </p>

        <div class="results-groups">
          {
            groupedAchievements.map((group) => (
              <div class="results-group">
                <h3 class="results-group__heading">■{group.category}合格実績</h3>
                <ul class="results-group__list">
                  {group.schools.map((achievement) => (
                    <li>{achievement.school}</li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>

        <div class="results-cta">
          <p>指導について、まずは気軽にご相談ください。</p>
          <CtaButton size="lg" />
          <p class="cta-note">
            <a href="/voices">ご利用者の声はこちら</a>
          </p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <StickyCta />
</BaseLayout>

<style>
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.78rem;
    color: var(--color-text-muted);
    margin-bottom: 32px;
  }

  .breadcrumb a {
    color: var(--color-text-muted);
    text-decoration: underline;
  }

  .breadcrumb a:hover {
    color: var(--color-brand-dark);
  }

  .results-note {
    max-width: 640px;
    margin: 20px auto 0;
    font-size: 0.78rem;
    color: var(--color-text-muted);
    line-height: 1.8;
    text-align: center;
  }

  .results-groups {
    max-width: 640px;
    margin: 40px auto 0;
    display: grid;
    gap: 36px;
  }

  .results-group__heading {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-brand-dark);
    padding-bottom: 10px;
    border-bottom: 2px solid var(--color-brand-tint);
    margin-bottom: 16px;
  }

  .results-group__list li {
    font-size: 0.95rem;
    line-height: 2.1;
    color: var(--color-text);
    padding-block: 2px;
  }

  .results-group__list li + li {
    border-top: 1px dashed var(--color-border);
  }

  .results-cta {
    text-align: center;
    margin-top: 64px;
  }

  .results-cta > p:first-child {
    font-weight: 700;
    margin-bottom: 16px;
  }
</style>

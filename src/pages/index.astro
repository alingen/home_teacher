---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import AvailabilitySection from "../components/AvailabilitySection.astro";
import WorriesSection from "../components/WorriesSection.astro";
import ProfileSection from "../components/ProfileSection.astro";
import AchievementsSection from "../components/AchievementsSection.astro";
import VoicesPreviewSection from "../components/VoicesPreviewSection.astro";
import PricingSection from "../components/PricingSection.astro";
import AreaSection from "../components/AreaSection.astro";
import FlowSection from "../components/FlowSection.astro";
import FaqSection from "../components/FaqSection.astro";
import FinalCtaSection from "../components/FinalCtaSection.astro";
import Footer from "../components/Footer.astro";
import StickyCta from "../components/StickyCta.astro";
---

<BaseLayout>
  <Header />
  <main id="main">
    <Hero />
    <AvailabilitySection />
    <WorriesSection />
    <ProfileSection />
    <AchievementsSection />
    <VoicesPreviewSection />
    <PricingSection />
    <AreaSection />
    <FlowSection />
    <FaqSection />
    <FinalCtaSection />
  </main>
  <Footer />
  <StickyCta />
</BaseLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import WorriesSection from "../components/WorriesSection.astro";
import PolicySection from "../components/PolicySection.astro";
import StudentTypesSection from "../components/StudentTypesSection.astro";
import SubjectsGradesSection from "../components/SubjectsGradesSection.astro";
import BenefitsSection from "../components/BenefitsSection.astro";
import ProfileSection from "../components/ProfileSection.astro";
import AreaSection from "../components/AreaSection.astro";
import PricingSection from "../components/PricingSection.astro";
import FlowSection from "../components/FlowSection.astro";
import FaqSection from "../components/FaqSection.astro";
import FinalCtaSection from "../components/FinalCtaSection.astro";
import Footer from "../components/Footer.astro";
import StickyCta from "../components/StickyCta.astro";
---

<BaseLayout>
  <Header />
  <main id="main">
    <Hero />
    <WorriesSection />
    <PolicySection />
    <StudentTypesSection />
    <SubjectsGradesSection />
    <BenefitsSection />
    <ProfileSection />
    <AreaSection />
    <PricingSection />
    <FlowSection />
    <FaqSection />
    <FinalCtaSection />
  </main>
  <Footer />
  <StickyCta />
</BaseLayout>

---
// SEO記事（コラム）用の共通レイアウト。
// 個々の記事ページ（src/pages/articles/*.astro）は、このレイアウトに
// 見出し・メタ情報を渡し、本文をスロットとして流し込むだけで作成できます。
import BaseLayout from "./BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import StickyCta from "../components/StickyCta.astro";
import CtaButton from "../components/CtaButton.astro";
import { site } from "../config/site";
import { profile } from "../data/profile";

interface Props {
  /** <title>・OGPに使うSEOタイトル（サイト名は付与しません。記事ごとに最適な文字数で指定してください） */
  seoTitle: string;
  /** meta description */
  description: string;
  /** ページ上部に表示するH1（SEOタイトルと同一である必要はありません） */
  h1: string;
  /** パンくずリストに表示する短いラベル。省略時はh1を使用 */
  breadcrumbLabel?: string;
  eyebrow?: string;
  /** 公開日（YYYY-MM-DD）。構造化データ（Article）に使用 */
  publishDate: string;
}

const { seoTitle, description, h1, breadcrumbLabel, eyebrow = "コラム", publishDate } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, site.url).toString();

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: h1,
  description,
  datePublished: publishDate,
  dateModified: publishDate,
  mainEntityOfPage: canonicalURL,
  author: {
    "@type": "Person",
    name: profile.name,
  },
  publisher: {
    "@type": "Organization",
    name: site.name,
  },
};
---

<BaseLayout title={seoTitle} description={description}>
  <Header />
  <main id="main">
    <article class="section">
      <div class="container article-container">
        <p class="breadcrumb">
          <a href="/">トップページ</a><span aria-hidden="true">›</span>{breadcrumbLabel ?? h1}
        </p>

        <header class="article-header">
          <span class="article-header__eyebrow">{eyebrow}</span>
          <h1>{h1}</h1>
        </header>

        <div class="article-body">
          <slot />
        </div>

        <div class="article-cta">
          <p>指導について、まずは気軽にご相談ください。</p>
          <CtaButton size="lg" />
        </div>

        <footer class="article-author">
          <p class="article-author__label">この記事を書いた人</p>
          <div class="article-author__card">
            {
              profile.photoSrc && (
                <img src={profile.photoSrc} alt={profile.photoAlt} class="article-author__photo" />
              )
            }
            <div>
              <p class="article-author__name">{profile.name}</p>
              <p class="article-author__bio">{profile.articleBio}</p>
            </div>
          </div>
        </footer>
      </div>
    </article>
  </main>
  <Footer />
  <StickyCta />

  <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} is:inline />
</BaseLayout>

<style>
  .article-container {
    max-width: 760px;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.78rem;
    color: var(--color-text-muted);
    margin-bottom: 32px;
  }

  .breadcrumb a {
    color: var(--color-text-muted);
    text-decoration: underline;
  }

  .breadcrumb a:hover {
    color: var(--color-brand-dark);
  }

  .article-header {
    margin-bottom: 40px;
  }

  .article-header__eyebrow {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--color-brand);
    background: var(--color-brand-tint);
    padding: 4px 14px;
    border-radius: 999px;
    margin-bottom: 14px;
  }

  .article-header h1 {
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 700;
    line-height: 1.5;
    letter-spacing: 0.01em;
  }

  /* -------------------------------------------------------------
     記事本文タイポグラフィ
     ------------------------------------------------------------- */
  .article-body :global(p) {
    font-size: 0.98rem;
    line-height: 2;
    color: var(--color-text);
  }

  .article-body :global(p + p) {
    margin-top: 20px;
  }

  .article-body :global(h2) {
    font-size: 1.3rem;
    font-weight: 700;
    line-height: 1.6;
    margin-top: 56px;
    margin-bottom: 20px;
    padding-bottom: 14px;
    border-bottom: 2px solid var(--color-brand-tint);
  }

  .article-body :global(> :first-child) {
    margin-top: 0;
  }

  .article-body :global(ul),
  .article-body :global(ol) {
    margin-top: 20px;
    margin-bottom: 20px;
    padding-left: 1.6em;
    display: grid;
    gap: 10px;
  }

  .article-body :global(ul) {
    list-style: disc;
  }

  .article-body :global(ol) {
    list-style: decimal;
  }

  .article-body :global(li) {
    font-size: 0.95rem;
    line-height: 1.9;
    color: var(--color-text);
  }

  .article-body :global(strong) {
    font-weight: 700;
  }

  .article-body :global(a) {
    color: var(--color-brand-dark);
    text-decoration: underline;
  }

  .article-body :global(a:hover) {
    color: var(--color-brand);
  }

  .article-body :global(.table-scroll) {
    overflow-x: auto;
    margin-block: 24px;
  }

  .article-body :global(table) {
    width: 100%;
    min-width: 560px;
    border-collapse: collapse;
    font-size: 0.88rem;
  }

  .article-body :global(th),
  .article-body :global(td) {
    border: 1px solid var(--color-border);
    padding: 10px 14px;
    text-align: left;
    line-height: 1.7;
  }

  .article-body :global(th) {
    background: var(--color-bg-alt);
    font-weight: 700;
    white-space: nowrap;
  }

  .article-cta {
    text-align: center;
    margin-top: 64px;
    padding-top: 48px;
    border-top: 1px solid var(--color-border);
  }

  .article-cta > p {
    font-weight: 700;
    margin-bottom: 16px;
  }

  .article-author {
    margin-top: 48px;
    padding-top: 32px;
    border-top: 1px solid var(--color-border);
  }

  .article-author__label {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--color-text-muted);
    letter-spacing: 0.03em;
    margin-bottom: 14px;
  }

  .article-author__card {
    display: flex;
    align-items: center;
    gap: 20px;
    background: var(--color-bg-alt);
    border-radius: var(--radius-lg);
    padding: 24px;
  }

  .article-author__photo {
    flex-shrink: 0;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
  }

  .article-author__name {
    font-weight: 700;
    font-size: 1rem;
    margin-bottom: 6px;
  }

  .article-author__bio {
    font-size: 0.85rem;
    line-height: 1.85;
    color: var(--color-text-muted);
  }

  @media (max-width: 480px) {
    .article-author__card {
      flex-direction: column;
      text-align: center;
    }
  }
</style>

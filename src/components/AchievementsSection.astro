---
// 表示内容はすべて src/data/achievements.ts から取得しています。
// 合格実績を追加・変更したい場合は data ファイルのみ編集してください。
import SectionHeading from "./SectionHeading.astro";
import { achievements } from "../data/achievements";
---

<section class="section" aria-labelledby="achievements-heading">
  <div class="container">
    <SectionHeading eyebrow="指導実績" title="合格実績" id="achievements-heading" />

    <p class="achievements-note">
      ※ 集団塾・個別指導塾ではなく、個人契約の家庭教師として指導した生徒の合格校のみを記載しています。
    </p>

    <ul class="grid grid--2 achievements-list">
      {
        achievements.map((achievement) => (
          <li class="card achievement-card">
            <span class="achievement-card__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" focusable="false">
                <path
                  d="M12 4L2 8.5l10 4.5 8.5-3.83V16"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
                <path
                  d="M6 10.5V15c0 1.66 2.69 3 6 3s6-1.34 6-3v-4.5"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </span>
            <span class="achievement-card__body">
              <span class="badge">{achievement.category}</span>
              <p class="achievement-card__school">{achievement.school}</p>
            </span>
          </li>
        ))
      }
    </ul>

    <p class="achievements-links">
      <a href="/results">合格実績の一覧を見る</a>
    </p>
  </div>
</section>

<style>
  .achievements-list {
    max-width: 640px;
    margin-inline: auto;
  }

  .achievement-card {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 22px;
    transition: box-shadow 0.15s ease, transform 0.15s ease;
  }

  .achievement-card:hover {
    box-shadow: 0 4px 20px rgba(28, 34, 34, 0.1);
    transform: translateY(-1px);
  }

  .achievement-card__icon {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--color-brand-tint);
    color: var(--color-brand-dark);
  }

  .achievement-card__icon svg {
    width: 22px;
    height: 22px;
  }

  .achievement-card__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    min-width: 0;
  }

  .achievement-card__school {
    font-size: 0.98rem;
    font-weight: 700;
    line-height: 1.5;
  }

  .achievements-note {
    max-width: 640px;
    margin: 20px auto 0;
    font-size: 0.78rem;
    color: var(--color-text-muted);
    line-height: 1.8;
  }

  .achievements-links {
    text-align: center;
    margin-top: 28px;
    font-size: 0.88rem;
  }

  .achievements-links a {
    color: var(--color-brand-dark);
    font-weight: 700;
    text-decoration: underline;
  }

  .achievements-links a:hover {
    color: var(--color-brand);
  }
</style>

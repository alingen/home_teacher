---
import SectionHeading from "./SectionHeading.astro";

const wards = ["東区", "博多区", "中央区", "南区", "城南区", "早良区", "西区"];
---

<section class="section" aria-labelledby="area-heading">
  <div class="container">
    <SectionHeading
      eyebrow="対応エリア"
      title="福岡市内の訪問指導をご相談いただけます"
      description="福岡市内の訪問指導についてご相談いただけます。訪問先・ご希望の日時・指導内容を伺い、対応可否をご案内します。"
      id="area-heading"
    />

    <div class="area-layout">
      <figure class="area-map">
        <img
          src="/images/fukuoka-city-map.svg"
          alt="福岡県の地図。福岡市の区域だけを緑色で強調しています。"
          width="480"
          height="420"
          loading="lazy"
          decoding="async"
        />
        <figcaption>
          出典：<a href="https://nlftp.mlit.go.jp/ksj/gml/datalist/KsjTmplt-N03-2026.html">国土交通省「国土数値情報（行政区域）」</a>を加工
        </figcaption>
      </figure>

      <div class="area-note">
        <p class="area-note__title">福岡市内全域からご相談いただけます</p>
        <p class="area-note__wards">{wards.map((ward) => <span>{ward}</span>)}</p>
        <p class="area-note__emphasis">記載のない地域からも、お気軽にご相談ください。</p>
      </div>
    </div>
  </div>
</section>

<style>
  :global(#area-heading) {
    text-wrap: balance;
  }

  .area-layout {
    display: grid;
    gap: 24px;
    max-width: 840px;
    margin-inline: auto;
    align-items: center;
  }

  @media (min-width: 720px) {
    .area-layout {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      gap: 40px;
    }
  }

  .area-map {
    margin: 0;
    min-width: 0;
  }

  .area-map img {
    width: 100%;
    height: auto;
  }

  .area-map figcaption {
    margin-top: 8px;
    font-size: 0.68rem;
    line-height: 1.7;
    text-align: center;
    color: var(--color-text-muted);
  }

  .area-map a {
    text-underline-offset: 3px;
  }

  .area-note {
    min-width: 0;
    background: var(--color-bg-alt);
    border-radius: var(--radius-lg);
    padding: 24px;
  }

  .area-note p {
    font-size: 0.9rem;
    line-height: 1.9;
    color: var(--color-text-muted);
  }

  .area-note .area-note__emphasis {
    margin-top: 12px;
    font-weight: 700;
    color: var(--color-brand-dark);
  }

  .area-note .area-note__title {
    margin-bottom: 12px;
    font-size: 1.1rem;
    font-weight: 700;
    line-height: 1.6;
    color: var(--color-brand-dark);
    text-wrap: balance;
  }

  .area-note__wards span {
    display: inline-block;
  }

  .area-note__wards span:not(:last-child)::after {
    content: "・";
  }
</style>

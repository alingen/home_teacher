---
import SectionHeading from "./SectionHeading.astro";
import { benefits } from "../data/benefits";
---

<section class="section" aria-labelledby="benefits-heading">
  <div class="container">
    <SectionHeading
      eyebrow="家庭教師を選ぶメリット"
      title="塾との併用や、塾からの切り替えにも"
      description="集団塾を否定するものではありません。1対1だからこそできることがあります。"
      id="benefits-heading"
    />
    <ul class="grid grid--2 benefits-list">
      {
        benefits.map((benefit) => (
          <li class="benefits-list__item">
            <h3>{benefit.title}</h3>
            <p>{benefit.description}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .benefits-list__item {
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 20px 22px;
  }

  .benefits-list__item h3 {
    font-size: 0.98rem;
    font-weight: 700;
    color: var(--color-brand-dark);
  }

  .benefits-list__item p {
    margin-top: 8px;
    font-size: 0.88rem;
    color: var(--color-text-muted);
    line-height: 1.8;
  }
</style>

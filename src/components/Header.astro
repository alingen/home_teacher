---
import { site } from "../config/site";
import CtaButton from "./CtaButton.astro";
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="#top" class="site-header__brand">
      <span class="site-header__brand-main">{site.name}</span>
      <span class="site-header__brand-sub">福岡市・地下鉄空港線沿線</span>
    </a>
    <div class="site-header__cta">
      <CtaButton label="LINEで相談する" />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: saturate(180%) blur(8px);
    border-bottom: 1px solid var(--color-border);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-block: 10px;
  }

  .site-header__brand {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--color-text);
    line-height: 1.3;
    min-width: 0;
  }

  .site-header__brand-main {
    font-weight: 700;
    font-size: 0.95rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .site-header__brand-sub {
    font-size: 0.68rem;
    color: var(--color-text-muted);
  }

  .site-header__cta :global(.cta-button) {
    padding: 9px 16px;
    font-size: 0.85rem;
    box-shadow: none;
  }

  @media (max-width: 480px) {
    .site-header__brand-sub {
      display: none;
    }
  }
</style>

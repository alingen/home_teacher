---
// ファーストビュー直下に表示する「受付状況」のお知らせ。
// 集客に直結する重要な情報のため、他セクションよりも目立つ配色・サイズにしていますが、
// 色自体はサイト全体のブランドカラー（ティール）＋控えめなアラート色にとどめています。
// 表示内容は src/data/availability.ts を編集するだけで更新できます。
import { availability } from "../data/availability";
---

<section class="availability" aria-label="受付状況のお知らせ">
  <div class="container">
    <div class="availability-card">
      <p class="availability-card__heading">現在の受付状況（{availability.updatedOnLabel}）</p>

      <dl class="availability-card__statuses">
        {
          availability.statuses.map((status) => (
            <div class="availability-card__status">
              <dt>{status.label}：</dt>
              <dd class={`is-${status.tone}`}>{status.value}</dd>
            </div>
          ))
        }
      </dl>

      {
        availability.messages.length > 0 && (
          <div class="availability-card__messages">
            {availability.messages.map((message) => (
              <p>{message}</p>
            ))}
          </div>
        )
      }

      {
        availability.notes.length > 0 && (
          <ul class="availability-card__notes">
            {availability.notes.map((note) => (
              <li>{note}</li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</section>

<style>
  .availability {
    padding-block: 28px 8px;
  }

  @media (min-width: 768px) {
    .availability {
      padding-block: 40px 8px;
    }
  }

  .availability-card {
    position: relative;
    max-width: 560px;
    margin-inline: auto;
    background: var(--color-brand-tint);
    border: 2px solid var(--color-brand);
    border-radius: var(--radius-lg);
    padding: 28px 24px;
    text-align: center;
    box-shadow: 0 12px 32px rgba(31, 111, 99, 0.16);
  }

  .availability-card__heading {
    display: inline-block;
    padding-bottom: 12px;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-text-muted);
    border-bottom: 1px dashed var(--color-brand);
  }

  .availability-card__statuses {
    display: grid;
    gap: 6px;
    margin-top: 18px;
  }

  /* 「ラベル：値」を1行に。狭い画面では値だけ次の行に回る */
  .availability-card__status {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: baseline;
    column-gap: 2px;
  }

  .availability-card__status dt {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .availability-card__status dd {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 800;
    line-height: 1.5;
  }

  @media (max-width: 400px) {
    .availability-card__status dd {
      font-size: 1.1rem;
    }
  }

  .availability-card__status dd.is-closed {
    color: #b3434b;
  }

  .availability-card__status dd.is-open {
    color: var(--color-brand-dark);
  }

  .availability-card__status dd.is-info {
    color: var(--color-text);
  }

  .availability-card__messages {
    display: grid;
    gap: 10px;
    margin-top: 20px;
    padding-top: 18px;
    border-top: 1px dashed var(--color-brand);
    text-align: left;
  }

  .availability-card__messages p {
    font-size: 0.9rem;
    line-height: 1.9;
    color: var(--color-text);
  }

  .availability-card__notes {
    display: grid;
    gap: 6px;
    margin-top: 14px;
    text-align: left;
  }

  .availability-card__notes li {
    position: relative;
    padding-left: 16px;
    font-size: 0.78rem;
    color: var(--color-text-muted);
    line-height: 1.8;
  }

  .availability-card__notes li::before {
    content: "※";
    position: absolute;
    left: 0;
  }
</style>

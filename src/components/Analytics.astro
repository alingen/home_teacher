---
// Google Analytics（GA4）の埋め込み。
// src/config/site.ts の gaMeasurementId に測定ID（G-XXXXXXXXXX）を設定するだけで
// 自動的に有効化されます。未設定の間は何も出力されないため、不要なJSを増やしません。
import { site } from "../config/site";

const { gaMeasurementId } = site;
---

{
  gaMeasurementId && (
    <>
      <script
        is:inline
        async
        src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}
      />
      <script is:inline define:vars={{ gaMeasurementId }}>
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          dataLayer.push(arguments);
        }
        gtag("js", new Date());
        gtag("config", gaMeasurementId);
      </script>
    </>
  )
}

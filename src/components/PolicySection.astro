---
import SectionHeading from "./SectionHeading.astro";
import { policyItems } from "../data/policy";
---

<section class="section section--alt" aria-labelledby="policy-heading">
  <div class="container">
    <SectionHeading
      eyebrow="指導方針"
      title="答えを教えるだけでなく、自分で勉強できる状態を目指します"
      description="ただ解き方を伝えるのではなく、次に似た問題が出たときに自分の力で解けるようになることを大切にしています。"
      id="policy-heading"
    />
    <ol class="policy-list">
      {
        policyItems.map((item, index) => (
          <li class="policy-list__item">
            <span class="policy-list__number" aria-hidden="true">
              {String(index + 1).padStart(2, "0")}
            </span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .policy-list {
    display: grid;
    gap: 16px;
    max-width: 760px;
    margin-inline: auto;
  }

  .policy-list__item {
    display: flex;
    gap: 20px;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 24px;
  }

  .policy-list__number {
    flex-shrink: 0;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-brand);
    font-variant-numeric: tabular-nums;
    min-width: 2ch;
  }

  .policy-list__item h3 {
    font-size: 1.02rem;
    font-weight: 700;
    line-height: 1.6;
  }

  .policy-list__item p {
    margin-top: 8px;
    font-size: 0.9rem;
    color: var(--color-text-muted);
    line-height: 1.85;
  }
</style>

---
import CtaButton from "./CtaButton.astro";

const heroPoints = [
  "中学生の数学・英語が中心（小学生・高校生もご相談可）",
  "福岡市内の訪問指導をご相談いただけます",
  "入会金・教材費一切なし",
  "同時指導は2人目が90%OFF",
];

// 講師の信頼材料。src/data/profile.ts の事実（学歴・指導歴・前職）と矛盾しないよう、
// 変更する場合は profile.ts 側の記載もあわせて確認してください。
const trustBadges = [
  "慶應義塾大学卒",
  "指導歴10年",
  "大手個別指導塾の元教室長",
];
---

<section class="hero" id="top" aria-label="ファーストビュー">
  <div class="container hero__inner">
    <div class="hero__content">
      <p class="hero__eyebrow">福岡市の訪問型個人家庭教師</p>
      <h1 class="hero__title">
        つまずきの原因まで戻り、<br />「自分で解ける」を一緒につくります
      </h1>
      <p class="hero__lead">
        中学生の数学・英語を中心に、ご自宅へ伺って指導します。勉強が苦手な子から、もっと成績を伸ばしたい子まで。一人ひとりに合わせて指導します。
      </p>

      <ul class="hero__points">
        {
          heroPoints.map((point) => (
            <li>
              <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                <path
                  d="M4 10.5l3.5 3.5L16 5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
              <span>{point}</span>
            </li>
          ))
        }
      </ul>

      <div class="hero__cta">
        <CtaButton size="lg" label="LINEで数学・英語の学習相談をする" />
        <p class="cta-note">
          2日以内に返信し、対応可否と体験の進め方をご案内します。
        </p>
        <p class="cta-note">無理な勧誘は一切行いません。まずはお話だけでも歓迎です。</p>
      </div>
    </div>

    <div class="hero__photo-card">
      <img src="/images/profile-hero.jpg" alt="講師の写真" class="hero__photo" />
      <ul class="hero__badges">
        {trustBadges.map((badge) => <li>{badge}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: 48px 56px;
    background: linear-gradient(180deg, var(--color-brand-tint) 0%, #ffffff 78%);
  }

  @media (min-width: 768px) {
    .hero {
      padding-block: 72px 80px;
    }
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    max-width: 720px;
  }

  @media (min-width: 900px) {
    .hero__inner {
      max-width: var(--container-width);
      flex-direction: row;
      align-items: center;
      gap: 56px;
    }
  }

  .hero__content {
    min-width: 0;
  }

  @media (min-width: 900px) {
    .hero__content {
      flex: 1;
    }
  }

  .hero__eyebrow {
    display: inline-block;
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--color-brand-dark);
    background: #ffffff;
    border: 1px solid var(--color-brand);
    padding: 5px 14px;
    border-radius: 999px;
    margin-bottom: 20px;
  }

  .hero__title {
    font-size: clamp(1.5rem, 5.5vw, 2.3rem);
    font-weight: 500;
    line-height: 1.55;
    letter-spacing: 0.01em;
    color: var(--color-text);
  }

  .hero__lead {
    margin-top: 20px;
    font-size: 1rem;
    color: var(--color-text-muted);
    line-height: 1.9;
    max-width: 56ch;
  }

  .hero__photo-card {
    margin-top: 28px;
    max-width: 300px;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 16px;
    box-shadow: var(--shadow-card);
  }

  @media (min-width: 900px) {
    .hero__photo-card {
      margin-top: 0;
      flex-shrink: 0;
      width: 300px;
    }
  }

  .hero__photo {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: calc(var(--radius-lg) - 6px);
  }

  .hero__badges {
    margin-top: 14px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .hero__badges li {
    background: var(--color-brand-tint);
    color: var(--color-brand-dark);
    font-size: 0.76rem;
    font-weight: 700;
    padding: 5px 11px;
    border-radius: 999px;
  }

  .hero__points {
    margin-top: 28px;
    display: grid;
    gap: 12px;
  }

  @media (min-width: 560px) {
    .hero__points {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .hero__points li {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 0.92rem;
    font-weight: 500;
  }

  .hero__points svg {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    margin-top: 1px;
    color: var(--color-brand);
  }

  .hero__cta {
    margin-top: 36px;
  }
</style>

---
// スマートフォンでの離脱を防ぐための下部固定CTA。
// デスクトップ幅ではヘッダー内のCTAが常に見えているため非表示にする（純粋にCSSのみで制御、JS不要）。
import CtaButton from "./CtaButton.astro";
---

<div class="sticky-cta" role="complementary" aria-label="家庭教師の相談用ショートカット">
  <div class="sticky-cta__inner">
    <CtaButton label="LINEで相談する" block />
  </div>
</div>

<style>
  .sticky-cta {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: saturate(180%) blur(8px);
    border-top: 1px solid var(--color-border);
    padding: 10px 16px calc(10px + env(safe-area-inset-bottom, 0));
    box-shadow: 0 -4px 18px rgba(28, 34, 34, 0.08);
  }

  .sticky-cta__inner {
    max-width: 480px;
    margin-inline: auto;
  }

  @media (min-width: 900px) {
    .sticky-cta {
      display: none;
    }
  }
</style>

---
// 料金の表示内容はすべて src/data/pricing.ts から取得しています。
// 金額を変更したい場合は、このコンポーネントではなく data ファイルを編集してください。
import SectionHeading from "./SectionHeading.astro";
import CtaButton from "./CtaButton.astro";
import { trialOffer, durations, pricingRows, siblingDiscount, pricingNotes } from "../data/pricing";
---

<section class="section section--alt" aria-labelledby="pricing-heading">
  <div class="container">
    <SectionHeading
      eyebrow="料金"
      title="料金プラン"
      description="授業時間が長くなるほど、1時間あたりの単価がお得になります。"
      id="pricing-heading"
    />

    <div class="sibling-discount">
      <div class="sibling-discount__percent">
        <span class="sibling-discount__num">{siblingDiscount.percent}%</span>
        <span class="sibling-discount__off">OFF</span>
      </div>
      <div class="sibling-discount__body">
        <span class="sibling-discount__label">{siblingDiscount.label}</span>
        <p>{siblingDiscount.description}</p>
      </div>
    </div>

    <div class="pricing-trial">
      <div>
        <span class="badge">{trialOffer.label}</span>
        <p class="pricing-trial__desc">{trialOffer.description}</p>
      </div>
      <div class="pricing-trial__price">
        <span class="pricing-trial__amount">{trialOffer.price}</span>
        <span class="pricing-trial__duration">{trialOffer.duration}</span>
      </div>
    </div>

    <div class="pricing-table-wrap">
      <table class="pricing-table">
        <caption class="sr-only">学年・授業時間別の料金一覧（1回あたり）</caption>
        <thead>
          <tr>
            <th scope="col">学年</th>
            {durations.map((duration) => <th scope="col">{duration}</th>)}
          </tr>
        </thead>
        <tbody>
          {
            pricingRows.map((row) => (
              <tr>
                <th scope="row">{row.grade}</th>
                {durations.map((duration) => (
                  <td>
                    <div class="pricing-table__cell">
                      <span class="pricing-table__total">{row.prices[duration].total}</span>
                      <span class="pricing-table__hourly">{row.prices[duration].hourlyRate}</span>
                    </div>
                  </td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <ul class="pricing-notes">
      {pricingNotes.map((note) => <li>{note}</li>)}
    </ul>

    <div class="pricing-cta">
      <CtaButton label="料金について相談する" />
    </div>
  </div>
</section>

<style>
  .pricing-trial {
    max-width: 720px;
    margin: 0 auto 24px;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 24px 28px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .pricing-trial__desc {
    margin-top: 10px;
    font-size: 0.88rem;
    color: var(--color-text-muted);
    max-width: 46ch;
    line-height: 1.8;
  }

  .pricing-trial__price {
    display: flex;
    align-items: baseline;
    gap: 6px;
    flex-shrink: 0;
  }

  .pricing-trial__amount {
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--color-brand-dark);
  }

  .pricing-trial__duration {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .pricing-table-wrap {
    max-width: 860px;
    margin-inline: auto;
    overflow-x: auto;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
  }

  .pricing-table {
    width: 100%;
    min-width: 480px;
    border-collapse: collapse;
    text-align: center;
  }

  .pricing-table th,
  .pricing-table td {
    padding: 16px 12px;
    border-bottom: 1px solid var(--color-border);
  }

  .pricing-table thead th {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-text-muted);
    background: var(--color-bg-alt);
  }

  .pricing-table thead th:first-child {
    text-align: left;
  }

  .pricing-table tbody th[scope="row"] {
    text-align: left;
    font-weight: 700;
    font-size: 0.95rem;
    white-space: nowrap;
  }

  .pricing-table tbody tr:last-child th,
  .pricing-table tbody tr:last-child td {
    border-bottom: none;
  }

  .pricing-table__cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }

  .pricing-table__total {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-brand-dark);
  }

  .pricing-table__hourly {
    font-size: 0.72rem;
    color: var(--color-text-muted);
  }

  .sibling-discount {
    max-width: 720px;
    margin: 0 auto 28px;
    background: var(--color-brand);
    color: #fff;
    border-radius: var(--radius-lg);
    padding: 22px 26px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 18px;
    box-shadow: 0 10px 28px rgba(31, 111, 99, 0.28);
  }

  .sibling-discount__percent {
    display: flex;
    align-items: baseline;
    gap: 4px;
    flex-shrink: 0;
  }

  .sibling-discount__num {
    font-size: 2.4rem;
    font-weight: 800;
    line-height: 1;
  }

  .sibling-discount__off {
    font-size: 1rem;
    font-weight: 700;
  }

  .sibling-discount__body {
    min-width: 0;
  }

  .sibling-discount__label {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--color-brand-dark);
    background: #fff;
    padding: 3px 10px;
    border-radius: 999px;
  }

  .sibling-discount__body p {
    margin-top: 8px;
    font-size: 0.9rem;
    line-height: 1.75;
  }

  .pricing-notes {
    max-width: 620px;
    margin: 32px auto 0;
    display: grid;
    gap: 8px;
  }

  .pricing-notes li {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    padding-left: 18px;
    position: relative;
    line-height: 1.8;
  }

  .pricing-notes li::before {
    content: "・";
    position: absolute;
    left: 0;
  }

  .pricing-cta {
    text-align: center;
    margin-top: 32px;
  }
</style>
